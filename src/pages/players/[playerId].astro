  }

  .profile-avatar {
    width: 180px;
  }

  .profile-info h1 {
    font-size: 40px;
  }

  .stat-grid {
    grid-template-columns: 1fr 1fr;
  }

  .stat-card {
    min-height: 120px;
    padding: 16px;
  }

  .stat-card strong,
  .stat-values strong {
    font-size: 26px;
  }

  .section-gap {
    margin-top: 48px;
  }

  .section-heading-row {
    align-items: flex-end;
  }

  .expandable-button {
    padding: 7px 10px;
    font-size: 10px;
  }

  /*
   * Seasons remain ONE LINE.
   * Horizontal scrolling is allowed if the screen is too narrow.
   */
  .season-list {
    overflow-x: auto;
  }

  .season-card {
    min-width: 620px;

    grid-template-columns:
      90px
      repeat(6, 75px);

    gap: 8px;
    padding: 16px;
  }

  /*
