  font-size: 11px;
}

.season-stat {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.season-stat span {
  color: var(--muted);
  font-size: 10px;
}

.season-stat strong {
  font-size: 17px;
}

.season-stat small {
