}


/* ============================================================
   SEASONS
   ============================================================ */

.season-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.season-card {
  display: grid;

  /* ONE LINE */
  grid-template-columns: minmax(120px, 1.5fr) repeat(6, 1fr);

  align-items: center;
  gap: 20px;

  padding: 20px 24px;

  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.season-title {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.season-title strong {
  font-size: 22px;
}

.season-title span {
