/* ============================================================
   ROUND HISTORY
   ============================================================ */

.round-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.round-card {
  display: grid;
  grid-template-columns: 1.5fr repeat(5, 1fr);
  align-items: center;
  gap: 20px;

  padding: 18px 24px;

