  font-size: 11px;
}

.round-name strong {
  font-size: 17px;
}

.round-card > div:not(.round-name) {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.round-card span {
  color: var(--muted);
  font-size: 10px;
}

.round-card strong {
  font-size: 15px;
}


/* ============================================================
   HEAD TO HEAD
   ============================================================ */

.h2h-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.h2h-card {
  display: grid;

  /* ONE LINE — player + 6 stats + arrow */
  grid-template-columns:
    minmax(180px, 1fr)
    75px
    75px
    85px
    75px
    85px
    85px
    25px;

  align-items: center;
  gap: 14px;

  padding: 12px 18px;

  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);

  color: var(--text);
  text-decoration: none;
}

.h2h-player {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.h2h-avatar {
  width: 44px;
  height: 44px;

  overflow: hidden;
  border-radius: 50%;
  background: #eee;

  flex-shrink: 0;
}

.h2h-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.h2h-player > div:last-child {
  display: flex;
  flex-direction: column;
  gap: 2px;

  min-width: 0;
}

.h2h-player strong {
  font-size: 14px;
}

.h2h-player span {
  color: var(--muted);
  font-size: 10px;
}

.h2h-stat {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.h2h-stat strong {
  font-size: 15px;
}

.h2h-stat span {
  color: var(--muted);
  font-size: 9px;
  text-transform: uppercase;
}

.h2h-arrow {
  color: var(--muted);
  font-size: 18px;
  text-align: right;
}


/* ============================================================
   MATCH HISTORY
   ============================================================ */

.match-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.match-card {
  display: grid;
  grid-template-columns: 150px 100px 1fr 100px 50px;
  align-items: center;
  gap: 20px;

  padding: 18px 20px;

  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.match-date {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.match-date span {
  font-size: 12px;
  font-weight: 700;
}

.match-date small {
  color: var(--muted);
  font-size: 10px;
}

.match-phase {
  color: var(--muted);
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
}

.match-opponent {
  display: flex;
  align-items: center;
  gap: 8px;
}

.match-opponent span {
  color: var(--muted);
  font-size: 11px;
}

.match-opponent strong {
  font-size: 14px;
}

.match-score {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  font-size: 18px;
}

.match-score span {
  color: var(--muted);
}

.match-result {
  font-size: 12px;
  font-weight: 900;
  text-align: center;
}

.match-result.win {
  color: #111;
}

.match-result.loss {
  color: #aaa;
}


/* ============================================================
   EXPANDABLE LISTS
   ============================================================ */

.expandable-section {
  position: relative;
}

/* Round history: show 3 initially */
.expandable-section:not(.expanded) .round-list > :nth-child(n + 4) {
  display: none;
}

/* Head to head: show 5 initially */
.expandable-section:not(.expanded) .h2h-list > :nth-child(n + 6) {
  display: none;
}

/* Match history: show 5 initially */
.expandable-section:not(.expanded) .match-list > :nth-child(n + 6) {
  display: none;
}


/* Fade at the bottom when collapsed */
.expandable-section:not(.expanded)::after {
  content: "··· MORE ···";
  position: absolute;

  left: 0;
  right: 0;
  bottom: 0;

  height: 80px;

  display: flex;
  align-items: flex-end;
  justify-content: center;

  padding-bottom: 0px;

  background: linear-gradient(
    to bottom,
    transparent 0%,
    rgba(245, 245, 245, 0.65) 45%,
    rgba(245, 245, 245, 0.95) 75%,
    var(--background) 100%
  );

  color: #999;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.16em;

  pointer-events: none;
}


/* Button in section heading */
.expandable-button {
  flex-shrink: 0;

  padding: 8px 12px;

  background: transparent;
  border: 1px solid var(--border);
  border-radius: 6px;

  color: var(--muted);
  font-size: 11px;
  font-weight: 700;

  cursor: pointer;

  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}

.expandable-button:hover {
  color: var(--text);
  background: var(--surface);
  border-color: #bbb;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

