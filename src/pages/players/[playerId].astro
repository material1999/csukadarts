---
import Layout from "../../layouts/Layout.astro";
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  const playerBioPath = path.join(
    process.cwd(),
    "public",
    "players",
    "player_bio.csv"
  );

  const playerBioData = fs.readFileSync(playerBioPath, "utf-8");

  const bioLines = playerBioData
    .trim()
    .split("\n")
    .filter((line) => line.trim() !== "");

  const bioHeaders = bioLines[0].split(";");

  const players = bioLines.slice(1).map((line) => {
    const values = line.split(";");

    return Object.fromEntries(
      bioHeaders.map((header, index) => [
        header,
        values[index]?.trim() || "",
      ])
    );
  });

  return players.map((player) => ({
    params: {
      playerId: player.player_id,
    },
    props: {
      player,
    },
  }));
}


// ============================================================
// Current player
// ============================================================

const { player } = Astro.props;


// ============================================================
// Load all players
// ============================================================

const playerBioPath = path.join(
  process.cwd(),
  "public",
  "players",
  "player_bio.csv"
);

const playerBioData = fs.readFileSync(playerBioPath, "utf-8");

const bioLines = playerBioData
  .trim()
  .split("\n")
  .filter((line) => line.trim() !== "");

const bioHeaders = bioLines[0].split(";");

const players = bioLines.slice(1).map((line) => {
  const values = line.split(";");

  return Object.fromEntries(
    bioHeaders.map((header, index) => [
      header,
      values[index]?.trim() || "",
    ])
  );
});


// ============================================================
// Load statistics
// ============================================================

const statsPath = path.join(
  process.cwd(),
  "public",
  "results",
  "generated",
  "player_stats.json"
);

const statsData = JSON.parse(
  fs.readFileSync(statsPath, "utf-8")
);

const stats = statsData[player.player_id];

if (!stats) {
  throw new Error(
    `No statistics found for player: ${player.player_id}`
  );
}


// ============================================================
// Helpers
// ============================================================

const formatPercent = (value: number | null | undefined) => {
  if (value === null || value === undefined) {
    return "—";
  }

  return `${value.toFixed(2)}%`;
};

const formatValue = (value: number | null | undefined) => {
  if (value === null || value === undefined) {
    return "—";
  }

  return value;
};

const getPlayerName = (id: string) => {
  const found = players.find((p) => p.player_id === id);

  return found?.player || id;
};

const getPlayerNickname = (id: string) => {
  const found = players.find((p) => p.player_id === id);

  return found?.nickname || "";
};


// ============================================================
// Darts
// ============================================================

let dartsWeight = "";
let dartsName = "";

if (player.darts_used) {
  const [weight, ...name] = player.darts_used.split(" ");

  dartsWeight = weight;
  dartsName = name.join(" ");
}
---

<Layout title={`${player.player} | Csuka Utca Invitational Masters`}>
  <div class="player-page">

    <!-- ======================================================
         PROFILE HEADER
         ====================================================== -->

    <section class="profile-hero">
      <div class="container">

        <a href="/players" class="back-link">
          ← All players
        </a>

        <div class="profile-header">

          <div class="profile-avatar">
            <img
              src={`/players/avatar/${player.player_id}.jpg`}
              alt={player.player}
              onerror={`this.onerror=null; this.src='/players/avatar/default.jpg';`}
            />
          </div>

          <div class="profile-info">

            <p class="profile-eyebrow">
              {player.nickname || "PLAYER"}
            </p>

            <h1>{player.player}</h1>

            <div class="profile-meta">
              <span>{player.nationality}</span>
              <span>·</span>
              <span>{player.hometown}</span>
            </div>

            {
              player.darts_used && (
                <div class="profile-darts">
                  <span class="darts-weight">{dartsWeight}</span>
                  <span>{dartsName}</span>
                </div>
              )
            }

            {
              player.walk_on_music && (
                <div class="walk-on">
                  <span class="walk-on-label">WALK-ON</span>
                  <span>{player.walk_on_music}</span>

                  <audio
                    controls
                    preload="none"
                    src={`/players/walk_on/${player.player_id}.mp3`}
                  />
                </div>
              )
            }

          </div>

        </div>
      </div>
    </section>


    <!-- ======================================================
         CAREER OVERVIEW
         ====================================================== -->

    <section class="content container">

      <div class="section-heading">
        <p class="eyebrow">CAREER</p>
        <h2>Overview</h2>
      </div>

      <div class="stat-grid">

        <div class="stat-card">
          <span class="stat-label">MATCHES</span>

          <strong>
            {stats.overview.matchesPlayed}
          </strong>

          <span class="stat-detail">
            {stats.overview.matchesWon}W · {stats.overview.matchesLost}L
          </span>
        </div>


        <div class="stat-card">
          <span class="stat-label">WIN RATE</span>

          <strong>
            {formatPercent(stats.overview.winRate)}
          </strong>

          <span class="stat-detail">
            match win rate
          </span>
        </div>


        <div class="stat-card">
          <span class="stat-label">LEGS</span>

          <strong>
            {stats.overview.legsPlayed}
          </strong>

          <span class="stat-detail">
            {stats.overview.legsWon}W · {stats.overview.legsLost}L
          </span>
        </div>


        <div class="stat-card">
          <span class="stat-label">LEG WIN RATE</span>

          <strong>
            {formatPercent(stats.overview.legWinRate)}
          </strong>

          <span class="stat-detail">
            leg win rate
          </span>
        </div>


        <div class="stat-card">
          <span class="stat-label">180s</span>

          <strong>
            {player.career_180s || 0}
          </strong>

          <span class="stat-detail">
            career total · {stats.bonuses["180s"] || 0} at tournament
          </span>

        </div>


        <div class="stat-card">
          <span class="stat-label">HIGHEST CHECKOUT</span>

          <strong>
            {formatValue(stats.bonuses.highestCheckout)}
          </strong>

          <span class="stat-detail">
            highest checkout
          </span>
        </div>


        <div class="stat-card">
          <span class="stat-label">SEASONS</span>

          <strong>
            {stats.overview.seasonsPlayed}
          </strong>

          <span class="stat-detail">
            seasons played
          </span>
        </div>


        <div class="stat-card">
          <span class="stat-label">ROUNDS</span>

          <strong>
            {stats.overview.roundsPlayed}
          </strong>

          <span class="stat-detail">
            rounds played
          </span>
        </div>

      </div>


      <!-- ====================================================
           FORM
           ==================================================== -->

      <div class="section-heading section-gap">
        <p class="eyebrow">FORM</p>
        <h2>Last 10 Matches</h2>
      </div>

      <div class="form-card">

        <div class="form-results">
          {
            stats.form.last10.map((result: string) => (
              <span
                class:list={[
                  "form-result",
                  result === "W" ? "win" : "loss",
                ]}
              >
                {result}
              </span>
            ))
          }
        </div>

        <div class="form-summary">

          <div>
            <span>Win rate</span>

            <strong>
              {formatPercent(stats.form.last10WinRate)}
            </strong>
          </div>

          <div>
            <span>Current streak</span>

            <strong>
              {stats.form.streaks.current}
              {stats.form.streaks.currentType === "W" ? "W" : "L"}
            </strong>
          </div>

          <div>
            <span>Longest win streak</span>

            <strong>
              {stats.form.streaks.longestWinning}
            </strong>
          </div>

          <div>
            <span>Longest loss streak</span>

            <strong>
              {stats.form.streaks.longestLosing}
            </strong>
          </div>

        </div>

      </div>

      <!-- ====================================================
           Rivals / Whitewashes / Shutouts
           ==================================================== -->

      <!-- Rivals & Special Stats -->
      <div class="section-heading section-gap">
        <p class="eyebrow">PROFILE</p>
        <h2>Rivals & Records</h2>
      </div>

      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-label">Dominating</span>

          {
            stats.rivals?.dominating ? (

                <strong>
                  {getPlayerName(stats.rivals.dominating.playerId)}
                </strong>
                <span>
                  {stats.rivals.dominating.matchesWon}{" "}
                  {stats.rivals.dominating.matchesWon === 1 ? "win" : "wins"}
                </span>
            ) : (
              <>
                <strong>—</strong>
                <span>No wins recorded</span>
              </>
            )
          }
        </div>

        <div class="stat-card">
          <span class="stat-label">Archrival</span>

          {
            stats.rivals?.archenemy ? (

                <strong>
                  {getPlayerName(stats.rivals.archenemy.playerId)}
                </strong>
                <span>
                  {stats.rivals.archenemy.matchesLost}{" "}
                  {stats.rivals.archenemy.matchesLost === 1 ? "loss" : "losses"}
                </span>

            ) : (
              <>
                <strong>—</strong>
                <span>No losses recorded</span>
              </>
            )
          }
        </div>

        <div class="stat-card">
          <span class="stat-label">Shutouts</span>
          <strong>{stats.shutouts?.count ?? 0}</strong>
          <span>{formatPercent(stats.shutouts?.percentage ?? 0)}</span>
        </div>

        <div class="stat-card">
          <span class="stat-label">Whitewashes</span>
          <strong>{stats.whitewashes?.count ?? 0}</strong>
          <span>{formatPercent(stats.whitewashes?.percentage ?? 0)}</span>
        </div>
      </div>


      <!-- ====================================================
           SEASONS
           ==================================================== -->

      <div class="section-heading section-gap">
        <p class="eyebrow">PERFORMANCE</p>
        <h2>Seasons</h2>
      </div>

      <div class="season-list">

        {
          Object.entries(stats.seasons)
            .sort(([a], [b]) => Number(b) - Number(a))
            .map(([season, data]: [string, any]) => (

              <div class="season-card">

                <div class="season-title">
                  <strong>{season}</strong>

                  <span>
                    {data.roundsPlayed} round
                    {data.roundsPlayed !== 1 ? "s" : ""}
                  </span>
                </div>

                <div class="season-stat">
                  <span>Standing</span>
                  <strong>
                    {data.standing ?? "—"}
                  </strong>
                </div>

                <div class="season-stat">
                  <span>Points</span>
                  <strong>
                    {data.points ?? "—"}
                  </strong>
                </div>

                <div class="season-stat">
                  <span>Matches</span>

                  <strong>
                    {data.matches.played}
                  </strong>

                  <small>
                    {data.matches.won}W · {data.matches.lost}L
                  </small>
                </div>

                <div class="season-stat">
                  <span>Win Rate</span>

                  <strong>
                    {formatPercent(data.matches.winRate)}
                  </strong>
                </div>

                <div class="season-stat">
                  <span>Legs</span>

                  <strong>
                    {data.legs.played}
                  </strong>

                  <small>
                    {data.legs.won}W · {data.legs.lost}L
                  </small>
                </div>

                <div class="season-stat">
                  <span>Leg Win Rate</span>

                  <strong>
                    {formatPercent(data.legs.winRate)}
                  </strong>
                </div>

              </div>
            ))
        }

      </div>


      <!-- ====================================================
           BONUSES
           ==================================================== -->


      <div class="section-heading section-gap">
        <p class="eyebrow">BONUSES</p>
        <h2>Tournament Bonuses</h2>
      </div>

      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-label">Bonus Points</span>
          <strong>{stats.bonuses?.total ?? 0}</strong>
        </div>

        <div class="stat-card">
          <span class="stat-label">Tournament 180s</span>
          <strong>{stats.bonuses?.["180s"] ?? 0}</strong>
        </div>

        <div class="stat-card">
          <span class="stat-label">Number of Highest Checkouts</span>
          <strong>{(stats.bonuses?.events ?? 0) - (stats.bonuses?.["180s"] ?? 0)}</strong>
        </div>

        <div class="stat-card">
          <span class="stat-label">Highest Checkout</span>
          <strong>{stats.bonuses?.highestCheckout ?? "—"}</strong>
        </div>
      </div>


      <!-- ====================================================
           ROUND HISTORY
           ==================================================== -->

      <div class="section-heading section-gap section-heading-row">

        <div>
          <p class="eyebrow">TOURNAMENTS</p>
          <h2>Round History</h2>
        </div>

        {
          stats.rounds.all.length > 3 && (
            <button
              class="expandable-button"
              data-expandable-button
            >
              Show all ↓
            </button>
          )
        }

      </div>

      <div
        class="expandable-section"
        data-expandable
      >

        <div class="round-list" data-expandable-list>

          {
            stats.rounds.all
              .slice()
              .sort(
                (a: any, b: any) =>
                  new Date(`${b.season}-01-01`).getTime() -
                  new Date(`${a.season}-01-01`).getTime()
              )
              .map((round: any) => (

                <div class="round-card">

                  <div class="round-name">
                    <span>{round.season}</span>
                    <strong>Round {round.round}</strong>
                  </div>

                  <div>
                    <span>Matches</span>
                    <strong>{round.matches}</strong>
                  </div>

                  <div>
                    <span>Record</span>
                    <strong>
                      {round.wins}W · {round.losses}L
                    </strong>
                  </div>

                  <div>
                    <span>Win Rate</span>
                    <strong>
                      {formatPercent(round.winRate)}
                    </strong>
                  </div>

                  <div>
                    <span>Legs</span>
                    <strong>
                      {round.legsWon}W · {round.legsLost}L
                    </strong>
                  </div>

                  <div>
                    <span>Leg Rate</span>
                    <strong>
                      {formatPercent(round.legWinRate)}
                    </strong>
                  </div>

                </div>

              ))
          }

        </div>

      </div>


      <!-- ====================================================
           HEAD TO HEAD
           ==================================================== -->

      <div class="section-heading section-gap section-heading-row">

        <div>
          <p class="eyebrow">MATCHUPS</p>
          <h2>Head to Head</h2>
        </div>

        {
          Object.keys(stats.headToHead).length > 5 && (
            <button
              class="expandable-button"
              data-expandable-button
            >
              Show all ↓
            </button>
          )
        }

      </div>

      <div
        class="expandable-section"
        data-expandable
      >

        <div class="h2h-list" data-expandable-list>

          {
            Object.entries(stats.headToHead)
              .sort(
                ([, a]: [string, any], [, b]: [string, any]) =>
                  b.matches - a.matches
              )
              .map(([opponentId, h2h]: [string, any]) => (

                <div class="h2h-card">

                  <div class="h2h-player">

                    <div class="h2h-avatar">
                      <img
                        src={`/players/avatar/${opponentId}.jpg`}
                        alt={getPlayerName(opponentId)}
                        onerror={`this.onerror=null; this.src='/players/avatar/default.jpg';`}
                      />
                    </div>

                    <div>
                      <strong>
                        {getPlayerName(opponentId)}
                      </strong>

                      {
                        getPlayerNickname(opponentId) && (
                          <span>
                            {getPlayerNickname(opponentId)}
                          </span>
                        )
                      }
                    </div>

                  </div>

                  <!-- Matches -->
                  <div class="h2h-stat">
                    <strong>{h2h.matches}</strong>
                    <span>matches</span>
                  </div>

                  <!-- Match record -->
                  <div class="h2h-stat">
                    <strong>
                      {h2h.wins}–{h2h.losses}
                    </strong>
                    <span>record</span>
                  </div>

                  <!-- Match win rate -->
                  <div class="h2h-stat">
                    <strong>
                      {formatPercent(h2h.winRate)}
                    </strong>
                    <span>win rate</span>
                  </div>

                  <!-- Leg record -->
                  <div class="h2h-stat">
                    <strong>
                      {h2h.legsWon}–{h2h.legsLost}
                    </strong>
                    <span>legs</span>
                  </div>

                  <!-- Leg win rate -->
                  <div class="h2h-stat">
                    <strong>
                      {formatPercent(h2h.legWinRate)}
                    </strong>
                    <span>leg win rate</span>
                  </div>

                  <!-- Average score difference -->
                  <div class="h2h-stat">
                    <strong>
                      {h2h.averageScoreDifference > 0 ? "+" : ""}
                      {formatValue(h2h.averageScoreDifference)}
                    </strong>
                    <span>avg. diff</span>
                  </div>

                  <span class="h2h-arrow">→</span>

                </div>

              ))
          }

        </div>

      </div>


      <!-- ====================================================
           MATCH HISTORY
           ==================================================== -->

      <div class="section-heading section-gap section-heading-row">

        <div>
          <p class="eyebrow">MATCHES</p>
          <h2>Match History</h2>
        </div>

        {
          stats.matches.length > 5 && (
            <button
              class="expandable-button"
              data-expandable-button
            >
              Show all ↓
            </button>
          )
        }

      </div>

      <div
        class="expandable-section"
        data-expandable
      >

        <div class="match-list" data-expandable-list>

          {
            stats.matches
              .slice()
              .sort(
                (a: any, b: any) =>
                  new Date(b.date).getTime() -
                  new Date(a.date).getTime()
              )
              .map((match: any) => (

                <div class="match-card">

                  <div class="match-date">
                    <span>{match.date}</span>

                    <small>
                      {match.season} · Round {match.round}
                    </small>
                  </div>

                  <div class="match-phase">
                    {match.phase}
                  </div>

                  <div class="match-opponent">
                    <span>vs</span>

                    <strong>
                      {getPlayerName(match.opponentId)}
                    </strong>
                  </div>

                  <div class="match-score">
                    <strong>{match.score}</strong>
                    <span>–</span>
                    <strong>{match.opponentScore}</strong>
                  </div>

                  <div
                    class:list={[
                      "match-result",
                      match.result === "W" ? "win" : "loss",
                    ]}
                  >
                    {match.result}
                  </div>

                </div>

              ))
          }

        </div>

      </div>

    </section>

  </div>
</Layout>


<style>

/* ============================================================
   GENERAL
   ============================================================ */

.player-page {
  min-height: calc(100vh - 76px);
}

.container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding-left: 32px;
  padding-right: 32px;
}


/* ============================================================
   PROFILE HERO
   ============================================================ */

.profile-hero {
  background: var(--dark);
  color: white;
  padding: 32px 0 64px;
}

.back-link {
  display: inline-block;
  margin-bottom: 40px;

  color: #999;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
}

.back-link:hover {
  color: white;
}

.profile-header {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 48px;
  align-items: center;
}

.profile-avatar {
  width: 280px;
  aspect-ratio: 1;
  overflow: hidden;
  background: #222;
  border-radius: var(--radius);
}

.profile-avatar img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.profile-eyebrow {
  margin: 0 0 8px;

  color: #888;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.profile-info h1 {
  margin: 0;

  font-size: clamp(42px, 6vw, 72px);
  line-height: 0.95;
  letter-spacing: -0.05em;
}

.profile-meta {
  display: flex;
  gap: 10px;
  margin-top: 16px;

  color: #aaa;
  font-size: 15px;
}

.profile-darts {
  display: flex;
  flex-direction: column;
  gap: 2px;

  margin-top: 28px;

  color: #ccc;
  font-size: 14px;
}

.profile-darts .darts-weight {
  color: white;
  font-weight: 800;
}

.walk-on {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;

  margin-top: 24px;

  color: #999;
  font-size: 13px;
}

.walk-on-label {
  color: #666;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.walk-on audio {
  width: min(400px, 100%);
  height: 36px;
}


/* ============================================================
   CONTENT
   ============================================================ */

.content {
  padding-top: 56px;
  padding-bottom: 100px;
}

.section-heading {
  margin-bottom: 20px;
}

.section-heading-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.eyebrow {
  margin: 0 0 8px;

  color: var(--muted);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.16em;
}

.section-heading h2 {
  margin: 0;

  font-size: 30px;
  line-height: 1;
  letter-spacing: -0.03em;
}

.section-gap {
  margin-top: 64px;
}


/* ============================================================
   CAREER STATS
   ============================================================ */

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.stat-card {
  min-height: 145px;

  padding: 20px;

  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);

  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.stat-label {
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.stat-card strong {
  font-size: 32px;
  line-height: 1;
  letter-spacing: -0.04em;
}

.stat-values {
  display: flex;
  align-items: flex-end;
  gap: 24px;
}

.stat-values > div {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.stat-values strong {
  font-size: 32px;
  line-height: 1;
  letter-spacing: -0.04em;
}

.stat-values span {
  color: var(--muted);
  font-size: 11px;
}

.stat-detail {
  color: var(--muted);
  font-size: 12px;
}


/* ============================================================
   FORM
   ============================================================ */

.form-card {
  padding: 24px;

  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.form-results {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.form-result {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  font-size: 12px;
  font-weight: 800;
}

.form-result.win {
  background: #111;
  color: white;
}

.form-result.loss {
  background: #ededed;
  color: #888;
}

.form-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);

  margin-top: 28px;
  padding-top: 24px;

  border-top: 1px solid var(--border);
}

.form-summary div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.form-summary span {
